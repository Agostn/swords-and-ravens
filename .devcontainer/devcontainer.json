{
  "name": "O GoT dos Games (site completo)",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "bash .devcontainer/instalar.sh",
  "postAttachCommand": "bash .devcontainer/iniciar.sh",
  "forwardPorts": [8000, 5000],
  "portsAttributes": {
    "8000": { "label": "Site (abra este)", "onAutoForward": "notify" },
    "5000": { "label": "Servidor do jogo", "onAutoForward": "silent" },
    "8001": { "label": "API interna (não abrir)", "onAutoForward": "ignore" },
    "8080": { "label": "Modo de teste rápido", "onAutoForward": "notify" }
  }
}
