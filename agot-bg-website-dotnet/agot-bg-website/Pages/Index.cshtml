@page
@model IndexModel
@{
    ViewData["Title"] = "Jogue Game of Thrones: The Board Game online";
    ViewData["TitleOverride"] = "Swords and Ravens - Jogue Game of Thrones: The Board Game online";
    ViewData["Description"] = "Jogue A Game of Thrones: The Board Game (2ª edição) online e de graça, ao vivo ou por turnos (PBEM), com amigos ou desconhecidos. Com as 3 expansões, tudo em português.";
}

@* JSON-LD so search engines can identify this as the canonical entry point for the game/site. *@
<script type="application/ld+json" nonce="@HttpContext.GetCspNonce()">
    @Html.Raw(Json.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebSite",
        ["name"] = "Swords and Ravens",
        ["url"] = $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}/",
        ["description"] = ViewData["Description"]
    }))
</script>

<div class="hero bg-base-200 rounded-box mt-6">
    <div class="hero-content text-center py-16">
        <div class="max-w-2xl">
            <h1 class="display-4 text-primary">Swords and Ravens</h1>
            <p class="py-4 text-base-content/80">
                Jogue <em>A Game of Thrones: The Board Game</em> (2ª edição, com as 3 expansões)
                online, ao vivo ou por turnos (PBEM), com amigos ou com quem quiser, tudo em português.
            </p>
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <div class="flex items-center justify-center gap-3">
                    <a class="btn btn-primary" asp-page="/MyGames">Minhas partidas</a>
                    <a class="btn btn-outline" asp-page="/Games">Todas as partidas</a>
                </div>
            }
            else
            {
                <div class="flex items-center justify-center gap-3">
                    <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Register">Criar uma conta</a>
                    <a class="btn btn-outline" asp-area="Identity" asp-page="/Account/Login">Entrar</a>
                </div>
            }
        </div>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-8">
    <div class="card bg-base-200 shadow-md">
        <div class="card-body">
            <h2 class="card-title text-secondary">Ao vivo ou por turnos</h2>
            <p>Entre numa partida ao vivo ou jogue no seu ritmo, um turno por vez (PBEM), recebendo aviso quando for sua vez.</p>
        </div>
    </div>
    <div class="card bg-base-200 shadow-md">
        <div class="card-body">
            <h2 class="card-title text-secondary">Chat na partida</h2>
            <p>Combine, negocie e traia rumo ao Trono de Ferro pelo chat da própria partida.</p>
        </div>
    </div>
    <div class="card bg-base-200 shadow-md">
        <div class="card-body">
            <h2 class="card-title text-secondary">Entre do seu jeito</h2>
            <p>Use nome de usuário e senha, ou entre com Google, Discord ou Facebook.</p>
        </div>
    </div>
</div>
