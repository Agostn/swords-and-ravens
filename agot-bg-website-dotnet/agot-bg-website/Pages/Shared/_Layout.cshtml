@inject IWebHostEnvironment HostEnvironment
@{
    // Per-page SEO hooks: pages set ViewData["Title"]/["Description"], falling back to site-wide defaults here.
    var pageDescription = ViewData["Description"] as string
        ?? "Jogue A Game of Thrones: The Board Game (2ª edição) online e de graça, ao vivo ou por turnos (PBEM), com amigos ou desconhecidos.";
    // Most pages get "Page - Swords and Ravens"; a page can set ViewData["TitleOverride"] for full control (e.g. the homepage leading with the brand name).
    var pageTitle = ViewData["TitleOverride"] as string ?? $"{ViewData["Title"]} - O GoT dos Games";
    var canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
}
<!DOCTYPE html>
<html lang="pt-BR" data-theme="swordsandravens">
<head>
    <meta charset="utf-8" />
    @* O site se ajusta ao celular e ao tablet (antes a página aparecia "de computador", miniatura). *@
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#120f0c" />
    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="O GoT dos Games" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}/raven.svg")" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@pageDescription" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    @* Instalar como app (Tela de Início do iPhone/Android): abre sem a barra do navegador *@
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="GoT dos Games" />
    <script type="importmap" nonce="@Context.GetCspNonce()"></script>
    <link rel="stylesheet" href="~/lib/fontawesome/css/fontawesome.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/solid.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/brands.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fonts/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        @* Connects the public/issues chat on every authenticated page of the site, not just
           Games/MyGames where the visible widget (_ChatWidget.cshtml) happens to be rendered -
           see chat-presence.js for why. Placed here (in <head>, before RenderBody's own markup)
           so this deferred module script initializes window.SnrChatPresence before _ChatWidget's
           own module script - appearing later in the page - runs and reads from it. *@
        <script type="module" nonce="@Context.GetCspNonce()">
            import { initChatPresence } from "/js/chat-presence.js";
            initChatPresence({
                chat: @Json.Serialize(agot_bg_website.Infrastructure.Chat.RoomSeeder.PublicRoomId.ToString()),
                issues: @Json.Serialize(agot_bg_website.Infrastructure.Chat.RoomSeeder.IssuesRoomId.ToString())
            });
        </script>
    }
</head>
<body class="min-h-screen bg-base-100 text-base-content flex flex-col lg:h-screen lg:overflow-hidden">
    <div class="site-backdrop" aria-hidden="true"></div>
    @* No iPhone com o site na Tela de Início (barra de status transparente), o topo fica
       por baixo da hora e da bateria: o espaço da "safe area" empurra o menu para baixo. *@
    <header class="shrink-0 sticky top-0 z-30" style="padding-top: env(safe-area-inset-top, 0px); padding-left: env(safe-area-inset-left, 0px); padding-right: env(safe-area-inset-right, 0px); background: var(--color-base-100, #120f0c);">
        <nav class="navbar bg-base-100/95 backdrop-blur border-b border-base-300 shadow-md">
            <div class="page-container flex items-center justify-between">
                <a class="brand flex items-center gap-2 shrink-0 px-1 sm:px-2 text-xl sm:text-2xl" asp-area="" asp-page="/Index">
                    <img src="~/raven.svg" asp-append-version="true" alt="" width="26" height="26" class="inline-block" />
                    O GoT dos Games
                </a>
                <div class="flex items-center gap-1">
                    <div class="hidden lg:flex items-center gap-1">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <a class="nav-link" asp-area="" asp-page="/Games">Todas as partidas</a>
                            <a class="nav-link" asp-area="" asp-page="/MyGames">Minhas partidas</a>
                            <a class="nav-link" asp-area="" asp-page="/Users">Jogadores</a>
                        }
                        <a class="nav-link" asp-area="" asp-page="/TermsOfUse">Termos de uso</a>
                        <a class="nav-link" asp-area="" asp-page="/About">Sobre</a>
                        @if (User.IsInRole(agot_bg_website.Infrastructure.Auth.RoleNames.Admin))
                        {
                            <a class="nav-link" asp-area="Admin" asp-page="/Index">Admin</a>
                        }
                    </div>
                    <div class="dropdown dropdown-end lg:hidden">
                        <div tabindex="0" role="button" class="btn btn-ghost btn-square" aria-label="Abrir menu">
                            <i class="fas fa-bars text-lg"></i>
                        </div>
                        <ul tabindex="0" class="dropdown-content menu z-20 mt-2 w-56 rounded-box border border-base-300 bg-base-200 p-2 shadow-md">
                            @if (User.Identity?.IsAuthenticated ?? false)
                            {
                                <li><a asp-area="" asp-page="/Games">Todas as partidas</a></li>
                                <li><a asp-area="" asp-page="/MyGames">Minhas partidas</a></li>
                                <li><a asp-area="" asp-page="/Users">Jogadores</a></li>
                            }
                            else
                            {
                                <li class="sm:hidden"><a asp-area="Identity" asp-page="/Account/Register">Criar conta</a></li>
                            }
                            <li><a asp-area="" asp-page="/TermsOfUse">Termos de uso</a></li>
                            <li><a asp-area="" asp-page="/About">Sobre</a></li>
                            @if (User.IsInRole(agot_bg_website.Infrastructure.Auth.RoleNames.Admin))
                            {
                                <li><a asp-area="Admin" asp-page="/Index">Admin</a></li>
                            }
                        </ul>
                    </div>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
        @if (HostEnvironment.IsStaging())
        {
            <div class="alert alert-warning rounded-none py-2 text-sm !grid-cols-1 !justify-items-center !text-center">
                @* DaisyUI's .alert is a two-column grid (an auto-sized icon column plus a
                   content column) from the sm breakpoint up, meant for two separate children.
                   Since icon and text are both wrapped in one <span> here, that single grid item
                   lands in the narrow auto-sized first column and gets pinned to the start -
                   plain justify-center/text-center on the container, or on the span itself, has
                   no effect since the span never actually gets stretched to the row's full width.
                   Force a single, full-width, centered column with "!" (important) utilities so
                   this doesn't depend on DaisyUI's two-child grid layout at all. *@
                <span>
                    <i class="fa-solid fa-flask-vial" aria-hidden="true"></i>
                    Este é um site de testes.
                </span>
            </div>
        }
    </header>

    <div class="flex-1 lg:overflow-y-auto">
        <div class="page-container @(ViewData["WideContainer"] as string == "md" ? "page-container-wide-md" : ViewData["WideContainer"] as bool? == true ? "page-container-wide" : "")">
            <main role="main" class="pt-6 pb-6">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="border-t border-base-300 py-3 text-sm opacity-70 shrink-0 bg-base-100/95 z-20">
        <div class="page-container flex items-center justify-center gap-1">
            <span>&copy; 2026 - O GoT dos Games (baseado no Swords and Ravens) -</span>
            <a class="link link-hover" asp-area="" asp-page="/Privacy">Privacidade</a>
            <span>-</span>
            <a class="link link-hover" asp-area="" asp-page="/TermsOfUse">Termos de uso</a>
            <span>-</span>
            <a class="link link-hover" asp-area="" asp-page="/Contact">Contato</a>
            <span>-</span>
            <a class="link link-hover" href="https://ko-fi.com/gereon77" target="_blank" rel="noopener noreferrer">Doar (projeto original)</a>
        </div>
    </footer>
    <partial name="_CookieConsentPartial" />

    <dialog id="game-settings-modal" class="modal">
        <div class="modal-box border border-base-300">
            <form method="dialog">
                <button class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3" aria-label="Fechar">
                    <i class="fas fa-xmark"></i>
                </button>
            </form>
            <h3 id="game-settings-modal-title" class="font-bold text-lg pr-10 break-words"></h3>
            <p id="game-settings-modal-owner-section" class="text-sm opacity-70">Criada por <span id="game-settings-modal-owner"></span></p>
            <p class="text-sm opacity-70">Criada em <span id="game-settings-modal-created-at"></span><span id="game-settings-modal-last-active-at-section" class="hidden"> · Última ação em <span id="game-settings-modal-last-active-at"></span></span></p>
            <div class="divider my-2"></div>
            <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
                <dt class="opacity-70">Configuração</dt>
                <dd id="game-settings-modal-setup"></dd>
                <dt class="opacity-70">Jogadores</dt>
                <dd id="game-settings-modal-players"></dd>
                <dt id="game-settings-modal-round-label" class="opacity-70 hidden">Rodada</dt>
                <dd id="game-settings-modal-round" class="hidden"></dd>
            </dl>
            <div class="mt-4">
                <p class="opacity-70 text-sm mb-1">Opções</p>
                <ul id="game-settings-modal-settings" class="list-disc list-inside space-y-0.5 text-sm"></ul>
                <p id="game-settings-modal-no-settings" class="opacity-70 italic text-sm hidden">Nenhuma opção extra ativada</p>
            </div>
            <div id="game-settings-modal-status-footer" class="hidden">
                <div class="divider my-2"></div>
                <p class="text-sm flex items-center gap-2">
                    <i id="game-settings-modal-status-crown" class="fa-solid fa-crown" title="Venceu" aria-label="Venceu" hidden></i>
                    <span id="game-settings-modal-status-label" class="opacity-70"></span>
                    <span id="game-settings-modal-status-value"></span>
                </p>
            </div>
            <div class="modal-action">
                <form method="dialog">
                    <button class="btn btn-sm">Fechar</button>
                </form>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>fechar</button>
        </form>
    </dialog>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    @* Aberto como app (pela Tela de Início): links do site que abririam outra aba
       (ex.: o nome da partida) abrem na mesma janela, senão o iPhone joga para o Safari. *@
    <script nonce="@Context.GetCspNonce()">
        (function () {
            var app = (window.matchMedia && window.matchMedia("(display-mode: standalone)").matches) || window.navigator.standalone === true;
            if (!app) return;
            document.addEventListener("click", function (e) {
                var a = e.target && e.target.closest ? e.target.closest("a[target=_blank]") : null;
                if (!a) return;
                var url = new URL(a.href, location.href);
                if (url.origin === location.origin) { a.removeAttribute("target"); }
            }, true);
        })();
    </script>
</body>
</html>
