@using Microsoft.AspNetCore.Http.Features
@{
    var consentFeature = Context.Features.Get<ITrackingConsentFeature>();
    var showBanner = !consentFeature?.CanTrack ?? false;
    var cookieString = consentFeature?.CreateConsentCookie();
}
@if (showBanner)
{
    <div id="cookieConsent" class="alert alert-dismissible border-t border-primary/40 bg-base-200 text-base-content fixed inset-x-0 bottom-0 z-50 max-h-[40vh] overflow-y-auto rounded-none flex-col sm:flex-row items-start gap-2 pb-[calc(0.75rem+env(safe-area-inset-bottom))]" role="alert">
        <span class="text-xs sm:text-sm">
            Usamos cookies para manter você conectado e lembrar suas preferências do jogo e do site
            (sem cookies de anúncios ou de rastreamento de terceiros). Se você entrar com Google,
            Discord ou Facebook, esses serviços também usam os próprios cookies quando você é levado até eles.
            Veja a nossa <a class="link link-hover" asp-page="/Privacy">Política de Privacidade</a> para mais detalhes.
        </span>
        <button type="button" class="accept-policy btn btn-sm btn-primary self-end sm:self-auto shrink-0" aria-label="Aceitar cookies" data-cookie-string="@cookieString">
            <span aria-hidden="true">Aceitar</span>
        </button>
    </div>
    <script nonce="@Context.GetCspNonce()">
        (function () {
            var banner = document.querySelector("#cookieConsent");
            var button = banner.querySelector("button[data-cookie-string]");
            button.addEventListener("click", function (event) {
                document.cookie = button.dataset.cookieString;
                banner.classList.add("hidden");
            }, false);
        })();
    </script>
}
