@page
@model agot_bg_website.Pages.UsersModel
@using System.Globalization
@using Microsoft.AspNetCore.Html
@using agot_bg_website.Infrastructure
@using agot_bg_website.Infrastructure.Auth
@{
    ViewData["Title"] = "Jogadores";
    // Wider container (1800px) when the action-buttons column is visible (Model.CanManageUserStatus);
    // otherwise a slightly narrower one (1600px) since the table has fewer columns to show.
    ViewData["WideContainer"] = Model.CanManageUserStatus ? (object)true : "md";

    // Builds a sortable column header link that preserves the current search/page-size and
    // resets back to page 1 (sorting differently makes the previous page number meaningless).
    IHtmlContent SortHeader(string column, string label)
    {
        var url = Url.Page(
            "./Users",
            new
            {
                Search = Model.Search,
                PageNumber = 1,
                PageSize = Model.PageSize,
                SortBy = column,
                SortDir = Model.NextSortDir(column),
                StatusFilter = Model.StatusFilter,
            }
        );
        var indicator = Model.SortIndicator(column);
        var text = string.IsNullOrEmpty(indicator) ? label : $"{label} {indicator}";
        return new HtmlString($"<a class=\"link link-hover text-base-content\" href=\"{url}\">{text}</a>");
    }
}

<h1 class="text-2xl font-bold mb-4">Jogadores</h1>

<partial name="_StatusMessage" for="StatusMessage" />

<form method="get" class="mb-4 flex gap-2 flex-wrap items-center">
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <input type="hidden" name="SortBy" value="@Model.SortBy" />
    <input type="hidden" name="SortDir" value="@Model.SortDir" />
    <input type="text" name="Search" value="@Model.Search" class="input" placeholder="Buscar pelo nome" />
    @if (Model.CanManageUserStatus)
    {
        <select name="StatusFilter" class="select" onchange="this.form.submit()">
            <option value="" selected="@(string.IsNullOrEmpty(Model.StatusFilter))">Todas as situações</option>
            <option value="probation" selected="@(Model.StatusFilter == "probation")">Em observação</option>
            <option value="tongueless" selected="@(Model.StatusFilter == "tongueless")">Sem Língua</option>
            <option value="banned" selected="@(Model.StatusFilter == "banned")">Banidos</option>
        </select>
    }
    <button type="submit" class="btn btn-primary">Buscar</button>
</form>

<div class="overflow-x-auto">
    <table class="table">
        <thead>
            <tr>
                <th class="whitespace-nowrap">@SortHeader("username", "Nome")</th>
                <th class="text-right whitespace-nowrap">@SortHeader("ongoing", "Em andamento")</th>
                <th class="text-right whitespace-nowrap">@SortHeader("finished", "Terminadas")</th>
                <th class="text-right whitespace-nowrap">@SortHeader("won", "Vitórias")</th>
                <th class="text-right whitespace-nowrap">@SortHeader("winrate", "Taxa de vitória")</th>
                <th class="text-right whitespace-nowrap">@SortHeader("removed", "Substituído")</th>
                <th class="text-right whitespace-nowrap">@SortHeader("replacer", "Como substituto")</th>
                <th class="whitespace-nowrap">@SortHeader("created", "Conta criada")</th>
                <th class="whitespace-nowrap">@SortHeader("activity", "Última atividade")</th>
                @if (Model.CanManageUserStatus)
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                var roles = Model.RolesByUserId.GetValueOrDefault(user.Id, []);
                // "Member" is every regular user's baseline role and carries no useful signal
                // here - only show a badge next to the username for anything beyond that (Admin,
                // High Member, Banned, On probation, Tongueless).
                var displayRoles = roles.Where(r => r != RoleNames.Member).ToList();
                var isProtected = roles.Contains(RoleNames.Admin) || roles.Contains(RoleNames.HighMember);
                var isBanned = roles.Contains(RoleNames.Banned);
                var isOnProbation = roles.Contains(RoleNames.OnProbation);
                var isTongueless = roles.Contains(RoleNames.Tongueless);
                var winRateDisplay = RoleBadges.FormatWinRate(user.CachedWinRate);
                <tr>
                    <td class="whitespace-nowrap">
                        <div class="flex flex-nowrap items-center gap-1">
                            <a class="link link-hover" href="/user/@user.Id">@user.DisplayName</a>
                            @foreach (var role in displayRoles)
                            {
                                <span class="badge badge-sm @RoleBadges.Classes.GetValueOrDefault(role, "badge-neutral")">@RoleBadges.DisplayName(role)</span>
                            }
                        </div>
                    </td>
                    <td class="text-right whitespace-nowrap">@Model.OngoingGamesCountByUserId.GetValueOrDefault(user.Id)</td>
                    <td class="text-right whitespace-nowrap">@(user.CachedFinishedGamesCount ?? 0)</td>
                    <td class="text-right whitespace-nowrap">@(user.CachedWonGamesCount ?? 0)</td>
                    <td class="text-right whitespace-nowrap">@winRateDisplay</td>
                    <td class="text-right whitespace-nowrap">@(user.CachedRemovedFromGameCount ?? 0)</td>
                    <td class="text-right whitespace-nowrap">@(user.CachedReplacerGamesCount ?? 0)</td>
                    <td class="whitespace-nowrap"><time datetime="@user.CreatedAt.ToString("O")" data-local-datetime-minute>@user.CreatedAt.ToLocalTime().ToString("g")</time></td>
                    <td class="whitespace-nowrap" title="@user.LastActivity.ToLocalTime().ToString("g")">@RelativeTimeFormatter.Format(user.LastActivity)</td>
                    @if (Model.CanManageUserStatus)
                    {
                        <td>
                            <div class="flex flex-nowrap items-center gap-2 h-8">
                                @if (isProtected)
                                {
                                    <span class="opacity-50 text-sm whitespace-nowrap">Protegido</span>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@user.Id" asp-route-role="@RoleNames.OnProbation" asp-route-Search="@Model.Search" asp-route-PageNumber="@Model.PageNumber" asp-route-PageSize="@Model.PageSize" asp-route-SortBy="@Model.SortBy" asp-route-SortDir="@Model.SortDir" asp-route-StatusFilter="@Model.StatusFilter">
                                        <button type="submit" class="btn btn-sm whitespace-nowrap @(isOnProbation ? "btn-success" : "btn-warning")">
                                            @(isOnProbation ? "Tirar observação" : "Em observação")
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@user.Id" asp-route-role="@RoleNames.Tongueless" asp-route-Search="@Model.Search" asp-route-PageNumber="@Model.PageNumber" asp-route-PageSize="@Model.PageSize" asp-route-SortBy="@Model.SortBy" asp-route-SortDir="@Model.SortDir" asp-route-StatusFilter="@Model.StatusFilter">
                                        <button type="submit" class="btn btn-sm whitespace-nowrap @(isTongueless ? "btn-success" : "btn-warning")">
                                            @(isTongueless ? "Devolver a língua" : "Sem Língua")
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@user.Id" asp-route-role="@RoleNames.Banned" asp-route-Search="@Model.Search" asp-route-PageNumber="@Model.PageNumber" asp-route-PageSize="@Model.PageSize" asp-route-SortBy="@Model.SortBy" asp-route-SortDir="@Model.SortDir" asp-route-StatusFilter="@Model.StatusFilter">
                                        <button type="submit" class="btn btn-sm whitespace-nowrap @(isBanned ? "btn-success" : "btn-error")">
                                            @(isBanned ? "Desbanir" : "Banir")
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="Model.Pager" />
