@page
@model ContactModel
@{
    ViewData["Title"] = "Contato";
    ViewData["Description"] = "Fale com a equipe do GoT dos Games.";
}

<h1 class="text-2xl font-bold mb-4">Fale com a gente</h1>

<partial name="_StatusMessage" model="Model.StatusMessage" />

@if (!Model.ContactEnabled)
{
    <div class="alert alert-warning mt-4" role="alert">
        O formulário de contato não está disponível agora. Tente de novo mais tarde.
    </div>
}
else
{
    <p class="mt-2 opacity-80">
        Dúvidas, bugs ou sugestões? Mande uma mensagem que a gente responde por e-mail.
        Você pode mandar até @Model.MaxMessagesPerDay mensagens por dia.
    </p>

    <div class="row mt-6">
        <div class="col-md-6">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-error mb-3" role="alert"></div>
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Name" class="form-control" readonly tabindex="-1" />
                        <label asp-for="Input.Name"></label>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" readonly tabindex="-1" />
                        <label asp-for="Input.Email"></label>
                    </div>
                }
                else
                {
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Name" class="form-control" autocomplete="name" aria-required="true" placeholder="Seu nome" />
                        <label asp-for="Input.Name"></label>
                        <span asp-validation-for="Input.Name" class="text-error text-sm"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="nome@exemplo.com" />
                        <label asp-for="Input.Email"></label>
                        <span asp-validation-for="Input.Email" class="text-error text-sm"></span>
                    </div>
                }
                <div class="form-floating mb-3">
                    <input asp-for="Input.Subject" class="form-control" aria-required="true" placeholder="Assunto" />
                    <label asp-for="Input.Subject"></label>
                    <span asp-validation-for="Input.Subject" class="text-error text-sm"></span>
                </div>
                <div class="form-floating mb-3">
                    <textarea asp-for="Input.Message" class="textarea w-full bg-base-200 text-base-content placeholder:text-base-content/40" rows="8" aria-required="true" placeholder="Como podemos ajudar?"></textarea>
                    <label asp-for="Input.Message"></label>
                    <span asp-validation-for="Input.Message" class="text-error text-sm"></span>
                </div>
                <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
                    <label asp-for="Input.Website">Website</label>
                    <input asp-for="Input.Website" tabindex="-1" autocomplete="off" />
                </div>
                @if (Model.TurnstileEnabled)
                {
                    <div class="cf-turnstile mb-3" data-sitekey="@Model.TurnstileSiteKey" data-action="contact"></div>
                }
                <button type="submit" class="btn btn-primary">Enviar mensagem</button>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.TurnstileEnabled)
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
}
