@page
@model GamesModel
@using agot_bg_website.Pages.Shared
@{
    ViewData["Title"] = "Todas as partidas";
}

<div class="flex flex-wrap items-end justify-between mb-5 gap-3">
    <div>
        <p class="kicker mb-1">Partidas</p>
        <h1 class="text-4xl">Todas as partidas</h1>
    </div>
    <a class="btn btn-ghost btn-sm text-base-content/70" href="https://ko-fi.com/gereon77" target="_blank" rel="noopener noreferrer">
        <i class="fas fa-mug-hot" aria-hidden="true"></i>
        Apoie o S&amp;R original no Ko-fi
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-error mb-4">@Model.ErrorMessage</div>
}

@if (Model.CanCreateGame)
{
    <section id="criar" class="hero-map mb-6">
        <div class="p-6 sm:p-8 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
            <div class="max-w-xl">
                <h2 class="text-3xl mb-2">Criar uma partida</h2>
                <p class="text-base-content/80 text-sm">
                    Dê um nome e clique em criar. Você vai para a <b>sala de espera</b>, onde escolhe o cenário
                    (jogo base ou expansões), o número de jogadores e as regras, e copia o link para chamar os amigos.
                </p>
            </div>
            <form method="post" asp-page-handler="CreateGame" class="flex flex-col sm:flex-row gap-3 w-full lg:w-[460px]">
                <input id="create-game-name" type="text" name="name" class="input input-lg flex-1 bg-base-100/80" placeholder="Ex.: A guerra dos amigos" maxlength="200" required />
                <button type="submit" class="btn btn-primary btn-lg px-6">Criar partida</button>
            </form>
        </div>
    </section>
}



<div class="flex flex-col gap-4">
    @if (Model.CurrentLiveGames.Count > 0)
    {
        <details class="collapse collapse-arrow bg-base-200 shadow-md border border-base-300" data-collapse-key="games-current-live"@(Model.Request.IsCollapseSectionOpen("games-current-live", true) ? " open" : "")>
            <summary class="collapse-title text-xl font-semibold">
                Partidas ao vivo agora <span class="badge badge-lg align-middle ml-1">@Model.CurrentLiveGames.Count</span>
            </summary>
            <div class="collapse-content">
                @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
                {
                    Games = Model.CurrentLiveGames,
                    ShowStateBadge = true,
                    ShowJoinAsOwner = true,
                    CanPlayAsAnotherPlayer = Model.CanPlayAsAnotherPlayer,
                    CanCancelGame = Model.CanCancelGame,
                    IsAuthenticated = true,
                    EmptyMessage = "Nenhuma partida ao vivo agora."
                })
            </div>
        </details>
    }

    <details class="collapse collapse-arrow bg-base-200 shadow-md border border-base-300" data-collapse-key="games-your-games"@(Model.Request.IsCollapseSectionOpen("games-your-games", true) ? " open" : "")>
        <summary class="collapse-title text-xl font-semibold">
            <a asp-page="/MyGames" class="link link-hover" title="Ir para Minhas partidas">Suas partidas</a> <span class="badge badge-lg align-middle ml-1">@Model.MyGames.Count</span>
        </summary>
        <div class="collapse-content">
            @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
            {
                Games = Model.MyGames,
                ShowStateBadge = true,
                CanCancelGame = Model.CanCancelGame,
                IsAuthenticated = true,
                EmptyMessage = "Você não está em nenhuma partida no momento."
            })
        </div>
    </details>

    <details class="collapse collapse-arrow bg-base-200 shadow-md border border-base-300" data-collapse-key="games-open"@(Model.Request.IsCollapseSectionOpen("games-open", true) ? " open" : "")>
        <summary class="collapse-title text-xl font-semibold">
            Partidas abertas <span class="badge badge-lg align-middle ml-1">@Model.OpenGames.Count</span>
        </summary>
        <div class="collapse-content">
            @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
            {
                Games = Model.OpenGames,
                ShowStateBadge = false,
                ShowJoinAsOwner = true,
                CanPlayAsAnotherPlayer = Model.CanPlayAsAnotherPlayer,
                CanCancelGame = Model.CanCancelGame,
                IsAuthenticated = true,
                EmptyMessage = "Nenhuma partida aberta agora."
            })
        </div>
    </details>

    <details class="collapse collapse-arrow bg-base-200 shadow-md border border-base-300" data-collapse-key="games-ongoing"@(Model.Request.IsCollapseSectionOpen("games-ongoing", true) ? " open" : "")>
        <summary class="collapse-title text-xl font-semibold">
            Partidas em andamento <span class="badge badge-warning badge-lg align-middle ml-1">@Model.OngoingGames.Count</span>
        </summary>
        <div class="collapse-content">
            @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
            {
                Games = Model.OngoingGames,
                ShowStateBadge = false,
                CanCancelGame = Model.CanCancelGame,
                IsAuthenticated = true,
                EmptyMessage = "Nenhuma partida em andamento agora."
            })
        </div>
    </details>

    @if (Model.ReplacementNeededGames.Count > 0)
    {
        <details class="collapse collapse-arrow bg-base-200 shadow-md border border-base-300" data-collapse-key="games-replacement-needed"@(Model.Request.IsCollapseSectionOpen("games-replacement-needed", true) ? " open" : "")>
            <summary class="collapse-title text-xl font-semibold" title="Partidas em que a última jogada foi há mais de 2 dias e o jogador da vez não entra no site há 8 dias.">
                Partidas esperando jogadores inativos <span class="badge badge-error badge-lg align-middle ml-1">@Model.ReplacementNeededGames.Count</span>
            </summary>
            <div class="collapse-content">
                @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
                {
                    Games = Model.ReplacementNeededGames,
                    ShowStateBadge = false,
                    ShowJoinAsWaited = true,
                    CanPlayAsAnotherPlayer = Model.CanPlayAsAnotherPlayer,
                    CanCancelGame = Model.CanCancelGame,
                    IsAuthenticated = true
                })
            </div>
        </details>
    }

    @if (Model.CanPlayAsAnotherPlayer && Model.InactiveGames.Count > 0)
    {
        <details class="collapse collapse-arrow bg-base-200 shadow-md border border-base-300" data-collapse-key="games-inactive"@(Model.Request.IsCollapseSectionOpen("games-inactive", true) ? " open" : "")>
            <summary class="collapse-title text-xl font-semibold">
                Partidas sem jogada há 5 dias <span class="badge badge-lg align-middle ml-1">@Model.InactiveGames.Count</span>
            </summary>
            <div class="collapse-content">
                @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
                {
                    Games = Model.InactiveGames,
                    ShowStateBadge = false,
                    ShowJoinAsWaited = true,
                    CanPlayAsAnotherPlayer = Model.CanPlayAsAnotherPlayer,
                    CanCancelGame = Model.CanCancelGame,
                    IsAuthenticated = true
                })
            </div>
        </details>
    }

    @if (Model.CanPlayAsAnotherPlayer && Model.InactiveTournamentGames.Count > 0)
    {
        <details class="collapse collapse-arrow bg-base-200 shadow-md border border-base-300" data-collapse-key="games-inactive-tournament"@(Model.Request.IsCollapseSectionOpen("games-inactive-tournament", true) ? " open" : "")>
            <summary class="collapse-title text-xl font-semibold">
                Partidas de torneio sem jogada há 2 dias <span class="badge badge-lg align-middle ml-1">@Model.InactiveTournamentGames.Count</span>
            </summary>
            <div class="collapse-content">
                @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
                {
                    Games = Model.InactiveTournamentGames,
                    ShowStateBadge = false,
                    ShowJoinAsWaited = true,
                    CanPlayAsAnotherPlayer = Model.CanPlayAsAnotherPlayer,
                    CanCancelGame = Model.CanCancelGame,
                    IsAuthenticated = true
                })
            </div>
        </details>
    }

    @if (Model.CanCancelGame && Model.InactivePrivateGames.Count > 0)
    {
        <details class="collapse collapse-arrow bg-base-200 shadow-md border border-base-300" data-collapse-key="games-inactive-private"@(Model.Request.IsCollapseSectionOpen("games-inactive-private", true) ? " open" : "")>
            <summary class="collapse-title text-xl font-semibold">
                Partidas privadas inativas <span class="badge badge-lg align-middle ml-1">@Model.InactivePrivateGames.Count</span>
            </summary>
            <div class="collapse-content">
                @await Html.PartialAsync("_GamesTable", new GamesTableViewModel
                {
                    Games = Model.InactivePrivateGames,
                    ShowStateBadge = false,
                    CanCancelGame = Model.CanCancelGame,
                    IsAuthenticated = true
                })
            </div>
        </details>
    }
</div>

<div class="mt-8">
    <h2 class="text-2xl mb-3">Conversa geral</h2>
    @await Html.PartialAsync("_ChatWidget", new agot_bg_website.Pages.Shared.ChatWidgetModel(
    agot_bg_website.Infrastructure.Chat.RoomSeeder.PublicRoomId,
    agot_bg_website.Infrastructure.Chat.RoomSeeder.IssuesRoomId,
    User.Identity?.IsAuthenticated ?? false,
    Model.LastFinishedGame))
</div>
