@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Verificação em duas etapas";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
@{
    var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
    @if (consentFeature?.CanTrack ?? true)
    {
        @if (Model.Is2faEnabled)
        {
            if (Model.RecoveryCodesLeft == 0)
            {
                <div class="alert alert-danger">
                    <div>
                        <strong>Você não tem mais códigos de recuperação.</strong>
                        <p>Você precisa <a asp-page="./GenerateRecoveryCodes">gerar códigos novos</a> antes de poder entrar com um código de recuperação.</p>
                    </div>
                </div>
            }
            else if (Model.RecoveryCodesLeft == 1)
            {
                <div class="alert alert-danger">
                    <div>
                        <strong>Você só tem 1 código de recuperação.</strong>
                        <p>Você pode <a asp-page="./GenerateRecoveryCodes">gerar códigos novos</a>.</p>
                    </div>
                </div>
            }
            else if (Model.RecoveryCodesLeft <= 3)
            {
                <div class="alert alert-warning">
                    <div>
                        <strong>Você tem @Model.RecoveryCodesLeft códigos de recuperação.</strong>
                        <p>É bom <a asp-page="./GenerateRecoveryCodes">gerar códigos novos</a>.</p>
                    </div>
                </div>
            }

            if (Model.IsMachineRemembered)
            {
                <form method="post" style="display: inline-block" class="mt-4">
                    <button type="submit" class="btn btn-primary">Esquecer este navegador</button>
                </form>
            }
            <div class="flex flex-wrap gap-3 mt-4 mb-4">
                <a asp-page="./Disable2fa" class="btn btn-primary">Desativar</a>
                <a asp-page="./GenerateRecoveryCodes" class="btn btn-primary">Gerar códigos de recuperação novos</a>
            </div>
        }

        <h4>App autenticador</h4>
        @if (!Model.HasAuthenticator)
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">Adicionar app autenticador</a>
        }
        else
        {
            <div class="flex flex-wrap gap-3">
                <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">Configurar app autenticador</a>
                <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-primary">Redefinir app autenticador</a>
            </div>
        }
    }
    else
    {
        <div class="alert alert-danger">
            <div>
                <strong>Você ainda não aceitou a política de privacidade e cookies.</strong>
                <p>Aceite a política antes de ativar a verificação em duas etapas.</p>
            </div>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
