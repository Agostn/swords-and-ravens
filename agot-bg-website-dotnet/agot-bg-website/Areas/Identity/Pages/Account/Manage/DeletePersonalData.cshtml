@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Apagar dados pessoais";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Apagar sua conta não pode ser desfeito.</strong> Seu e-mail, senha, nome de usuário,
        texto do perfil e logins ligados serão apagados para sempre. Nas partidas que você já jogou,
        você vai aparecer como <strong>"Took the Black"</strong> (vestiu o negro), mas não vai mais conseguir
        entrar, e essas partidas não vão mais contar na sua taxa de vitória.
    </p>
</div>

<div>
    <form id="delete-user" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        @if (Model.RequirePassword)
        {
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Digite sua senha." />
                <label asp-for="Input.Password" class="form-label"></label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
        }
        <button class="w-full btn btn-lg btn-danger" type="submit">Apagar meus dados e encerrar minha conta</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
