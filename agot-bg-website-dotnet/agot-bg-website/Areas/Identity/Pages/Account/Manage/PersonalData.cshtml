@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Dados pessoais";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-6">
        <p>Sua conta tem dados pessoais que você nos deu. Aqui você pode baixar ou apagar esses dados.</p>
        <p>
            <strong>Apagar esses dados remove sua conta para sempre, sem como recuperar.</strong>
        </p>
        <div class="flex flex-wrap gap-3">
            <form id="download-data" asp-page="DownloadPersonalData" method="post">
                <button class="btn btn-primary" type="submit">Baixar</button>
            </form>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">Apagar</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
