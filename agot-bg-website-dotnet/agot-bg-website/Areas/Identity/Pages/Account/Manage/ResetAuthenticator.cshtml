@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Redefinir chave do autenticador";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <div>
        <p>
            <strong>Se você redefinir a chave, o app autenticador para de funcionar até você configurá-lo de novo.</strong>
        </p>
        <p>
            Isso desativa a verificação em duas etapas até você confirmar o app autenticador.
            Se não terminar a configuração do app, você pode perder o acesso à sua conta.
        </p>
    </div>
</div>
<div class="mt-4">
    <form id="reset-authenticator-form" method="post">
        <button id="reset-authenticator-button" class="btn btn-danger" type="submit">Redefinir chave do autenticador</button>
    </form>
</div>
