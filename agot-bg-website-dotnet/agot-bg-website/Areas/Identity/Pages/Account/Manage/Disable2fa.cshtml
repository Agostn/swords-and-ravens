@page
@model Disable2faModel
@{
    ViewData["Title"] = "Desativar a verificação em duas etapas";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <div>
        <p>
            <strong>Isto só desativa a verificação em duas etapas.</strong>
        </p>
        <p>
            Desativar não muda a chave usada no app autenticador. Se quiser trocar essa chave,
            você deve <a asp-page="./ResetAuthenticator">redefinir a chave do autenticador.</a>
        </p>
    </div>
</div>

<div class="mt-4">
    <form method="post">
        <button class="btn btn-danger" type="submit">Desativar</button>
    </form>
</div>
