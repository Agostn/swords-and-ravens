@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Gerar códigos de recuperação";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <div>
        <p>
            <strong>Guarde estes códigos num lugar seguro.</strong>
        </p>
        <p>
            Se você perder o aparelho e não tiver os códigos de recuperação, vai perder o acesso à sua conta.
        </p>
        <p>
            Gerar códigos novos não muda a chave usada no app autenticador. Se quiser trocar essa chave,
            você deve <a asp-page="./ResetAuthenticator">redefinir a chave do autenticador.</a>
        </p>
    </div>
</div>
<div class="mt-4">
    <form method="post">
        <button class="btn btn-danger" type="submit">Gerar códigos de recuperação</button>
    </form>
</div>
