@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Criar conta";
}

<h1>@ViewData["Title"]</h1>
<h2 id="external-login-title">Ligar sua conta do @Model.ProviderDisplayName.</h2>
<hr />

<p id="external-login-description" class="text-info">
    Você entrou com sucesso pelo <strong>@Model.ProviderDisplayName</strong>.
    Escolha abaixo um nome de usuário (é o nome que os outros jogadores vão ver) e clique em
    Criar conta para terminar.
</p>

<div class="row">
    <div class="col-md-4">
        <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.UserName" class="form-control" autocomplete="username" placeholder="Digite um nome de usuário." />
                <label asp-for="Input.UserName" class="form-label"></label>
                <span asp-validation-for="Input.UserName" class="text-danger"></span>
            </div>
            <p class="form-text text-muted">
                Este nome aparece para os outros jogadores (por exemplo, na lista de quem está online e no chat das partidas) e
                só pode ser trocado uma vez depois, nas configurações do seu perfil.
            </p>
            <div class="form-floating mb-3">
                @if (Model.EmailIsReadOnly)
                {
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" readonly />
                }
                else
                {
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="Digite seu e-mail."/>
                }
                <label asp-for="Input.Email" class="form-label"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            @if (Model.EmailIsReadOnly)
            {
                <p class="form-text text-muted">
                    Este é o e-mail confirmado da sua conta do @Model.ProviderDisplayName e não pode ser trocado aqui.
                </p>
            }
            <button type="submit" class="w-100 btn btn-lg btn-primary">Criar conta</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
