@page
@model LoginModel

@{
    ViewData["Title"] = "Entrar";
}

<h1>@ViewData["Title"]</h1>
<div class="row">
    <div class="col-md-4">
        <section>
            <form id="account" method="post">
                <h2>Entre com seu e-mail e senha.</h2>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nome@exemplo.com" />
                    <label asp-for="Input.Email" class="form-label">E-mail</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="senha" />
                    <label asp-for="Input.Password" class="form-label">Senha</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-check mb-3">
                    <label asp-for="Input.RememberMe" class="form-label">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>
                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Entrar</button>
                </div>
                <div>
                    <p>
                        <a id="forgot-password" asp-page="./ForgotPassword">Esqueceu a senha?</a>
                    </p>
                    <p>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Criar uma conta nova</a>
                    </p>
                    <p>
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Reenviar o e-mail de confirmação</a>
                    </p>
                </div>
            </form>
        </section>
    </div>
    <div class="col-md-6 col-md-offset-2">
        <section class="mt-8 md:mt-0">
            <h3>Ou entre com outro serviço.</h3>
            <hr class="mt-2 border-base-300 opacity-60" />
            @{
                if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <div class="mt-6">
                        <p>
                            Nenhum outro serviço de login (Google, Discord, Facebook) está ativado neste site no momento.
                        </p>
                    </div>
                }
                else
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal mt-6">
                        <div class="space-y-4">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                var providerKey = provider.Name.ToLowerInvariant();
                                var providerLabel = provider.DisplayName ?? provider.Name;
                                var brandColor = providerKey switch
                                {
                                    "google" => "#DB4437",
                                    "discord" => "#7289DA",
                                    "facebook" => "#1877F2",
                                    _ => "#8a1f2b"
                                };
                                var borderColor = providerKey switch
                                {
                                    "discord" => "rgba(0,0,0,.2)",
                                    _ => "rgba(0,0,0,.18)"
                                };
                                var iconClass = providerKey switch
                                {
                                    "google" => "fa-brands fa-google",
                                    "discord" => "fa-brands fa-discord",
                                    "facebook" => "fa-brands fa-facebook",
                                    _ => "fa-solid fa-right-to-bracket"
                                };
                                var buttonText = $"Entrar com {providerLabel}";
                                var iconContainerClass = providerKey == "google"
                                    ? "absolute left-4 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white text-xl shadow-sm"
                                    : "absolute left-5 inline-flex h-8 w-8 items-center justify-center text-2xl";
                                var iconStyle = providerKey == "google"
                                    ? "color: #DB4437; top: 50%; transform: translateY(-50%);"
                                    : "color: #ffffff; top: 50%; transform: translateY(-50%);";

                                <button type="submit"
                                        class="btn btn-lg relative w-full justify-center px-5 text-white shadow-md transition hover:brightness-90"
                                        style="background-color: @brandColor; border-color: @borderColor;"
                                        name="provider"
                                        value="@provider.Name"
                                        title="Entrar usando sua conta do @providerLabel">
                                    <span class="@iconContainerClass" style="@iconStyle" aria-hidden="true">
                                        <i class="@iconClass"></i>
                                    </span>
                                    <span class="font-semibold normal-case tracking-wide">@buttonText</span>
                                </button>
                            }
                        </div>
                    </form>
                }
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
