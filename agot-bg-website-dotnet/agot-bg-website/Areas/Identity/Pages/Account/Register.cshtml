@page
@model RegisterModel
@{
    ViewData["Title"] = "Criar conta";
}

<div class="max-w-md mx-auto mt-4 flex flex-col gap-4">
    <div class="panel p-6 sm:p-8">
        <p class="kicker mb-1">Nova conta</p>
        <h1 class="text-4xl mb-2">Criar uma conta</h1>
        <p class="text-sm text-base-content/70 mb-6">
            Cada jogador precisa da sua conta. Ao criar uma, você confirma que tem uma cópia original do jogo de tabuleiro físico.
        </p>
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.UserName" class="form-control" autocomplete="username" aria-required="true" placeholder="Nome de usuário" />
                <label asp-for="Input.UserName">Nome de usuário</label>
                <span asp-validation-for="Input.UserName" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="nome@exemplo.com" />
                <label asp-for="Input.Email">E-mail</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="senha" />
                <label asp-for="Input.Password">Senha</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="senha" />
                <label asp-for="Input.ConfirmPassword">Confirme a senha</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
                <label asp-for="Input.Website">Website</label>
                <input asp-for="Input.Website" tabindex="-1" autocomplete="off" />
            </div>
            @if (Model.TurnstileEnabled)
            {
                <div class="cf-turnstile mb-3" data-sitekey="@Model.TurnstileSiteKey" data-action="register"></div>
            }
            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Criar conta</button>
        </form>
        <p class="mt-5 text-sm text-base-content/75">Já tem conta? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Entrar</a></p>
    </div>
    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
    {
    <div class="panel p-6 sm:p-8">
        <section>
            <h3>Ou crie a conta com outro serviço.</h3>
            <hr class="mt-2 border-base-300 opacity-60" />
            @{
                if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <div class="mt-6">
                        <p>
                            Nenhum outro serviço de login (Google, Discord, Facebook) está ativado neste site no momento.
                        </p>
                    </div>
                }
                else
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal mt-6">
                        <div class="space-y-4">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                var providerKey = provider.Name.ToLowerInvariant();
                                var providerLabel = provider.DisplayName ?? provider.Name;
                                var brandColor = providerKey switch
                                {
                                    "google" => "#DB4437",
                                    "discord" => "#7289DA",
                                    "facebook" => "#1877F2",
                                    _ => "#8a1f2b"
                                };
                                var borderColor = providerKey switch
                                {
                                    "discord" => "rgba(0,0,0,.2)",
                                    _ => "rgba(0,0,0,.18)"
                                };
                                var iconClass = providerKey switch
                                {
                                    "google" => "fa-brands fa-google",
                                    "discord" => "fa-brands fa-discord",
                                    "facebook" => "fa-brands fa-facebook",
                                    _ => "fa-solid fa-right-to-bracket"
                                };
                                var buttonText = $"Criar conta com {providerLabel}";
                                var iconContainerClass = providerKey == "google"
                                    ? "absolute left-4 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white text-xl shadow-sm"
                                    : "absolute left-5 inline-flex h-8 w-8 items-center justify-center text-2xl";
                                var iconStyle = providerKey == "google"
                                    ? "color: #DB4437; top: 50%; transform: translateY(-50%);"
                                    : "color: #ffffff; top: 50%; transform: translateY(-50%);";

                                <button type="submit"
                                        class="btn btn-lg relative w-full justify-center px-5 text-white shadow-md transition hover:brightness-90"
                                        style="background-color: @brandColor; border-color: @borderColor;"
                                        name="provider"
                                        value="@provider.Name"
                                        title="Usar sua conta do @providerLabel">
                                    <span class="@iconContainerClass" style="@iconStyle" aria-hidden="true">
                                        <i class="@iconClass"></i>
                                    </span>
                                    <span class="font-semibold normal-case tracking-wide">@buttonText</span>
                                </button>
                            }
                        </div>
                    </form>
                }
            }
        </section>
    </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.TurnstileEnabled)
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
}
