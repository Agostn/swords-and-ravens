@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirme seu e-mail";
}

<h1>@ViewData["Title"]</h1>
@{
    if (@Model.DisplayConfirmAccountLink)
    {
<p>
    Este site ainda não tem um serviço de envio de e-mail configurado (veja <a href="https://aka.ms/aspaccountconf">a documentação</a> para configurar).
    Normalmente isto iria por e-mail: <a id="confirm-link" href="@Model.EmailConfirmationUrl">Clique aqui para confirmar sua conta</a>
</p>
    }
    else
    {
<p>
        Mandamos um link para o seu e-mail. Abra o e-mail e clique no link para confirmar sua conta (olhe também no spam).
</p>
    }
}

