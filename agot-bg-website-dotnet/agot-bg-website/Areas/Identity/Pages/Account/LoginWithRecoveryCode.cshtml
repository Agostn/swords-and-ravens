@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Entrar com código de recuperação";
}

<h1>@ViewData["Title"]</h1>
<hr />
<p>
    Você pediu para entrar com um código de recuperação. Este login não fica lembrado até você usar
    um código do app autenticador ao entrar, ou desativar a verificação em duas etapas e entrar de novo.
</p>
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="Código de recuperação" />
                <label asp-for="Input.RecoveryCode" class="form-label"></label>
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>
            <button type="submit" class="w-full btn btn-lg btn-primary">Entrar</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}