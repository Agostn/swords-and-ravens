@page
@model BannedModel
@{
    ViewData["Title"] = "Conta banida";
}

<header>
    <h1 class="text-danger">@ViewData["Title"]</h1>
    <p class="text-danger">Sua conta foi banida e não pode mais entrar no site.</p>
    <p>Se você acha que isso foi um engano, fale com os administradores do site.</p>
</header>
