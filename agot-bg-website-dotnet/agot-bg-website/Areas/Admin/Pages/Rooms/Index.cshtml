@page
@model agot_bg_website.Areas.Admin.Pages.Rooms.IndexModel
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "Admin - Salas";

    // Builds a sortable column header link that preserves the current search/page-size and
    // resets back to page 1 (sorting differently makes the previous page number meaningless).
    IHtmlContent SortHeader(string column, string label)
    {
        var url = Url.Page(
            "./Index",
            new
            {
                Search = Model.Search,
                PageNumber = 1,
                PageSize = Model.PageSize,
                SortBy = column,
                SortDir = Model.NextSortDir(column),
            }
        );
        var indicator = Model.SortIndicator(column);
        var text = string.IsNullOrEmpty(indicator) ? label : $"{label} {indicator}";
        return new HtmlString($"<a class=\"link link-hover text-base-content\" href=\"{url}\">{text}</a>");
    }
}

<partial name="_AdminNav" />

<h1 class="text-2xl font-bold mb-4">Salas de chat</h1>

<form method="get" class="mb-4 flex gap-2">
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <input type="hidden" name="SortBy" value="@Model.SortBy" />
    <input type="hidden" name="SortDir" value="@Model.SortDir" />
    <input type="text" name="Search" value="@Model.Search" class="input" placeholder="Buscar por nome ou id" />
    <button type="submit" class="btn btn-primary">Buscar</button>
</form>

<div class="overflow-x-auto">
    <table class="table">
        <thead>
            <tr>
                <th>@SortHeader("name", "Nome")</th>
                <th>@SortHeader("public", "Pública")</th>
                <th>@SortHeader("maxRetrieveCount", "Máx. de mensagens carregadas")</th>
                <th>Mensagens</th>
                <th>@SortHeader("created", "Criada")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var room in Model.Rooms)
            {
                <tr>
                    <td>@room.Name</td>
                    <td>@(room.Public ? "Sim" : "Não")</td>
                    <td>@(room.MaxRetrieveCount?.ToString() ?? "-")</td>
                    <td>@Model.MessageCountByRoomId.GetValueOrDefault(room.Id, 0).ToString("N0")</td>
                    <td>@room.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td>
                        <a class="btn btn-sm" asp-area="Admin" asp-page="/Messages/Index" asp-route-roomId="@room.Id">Ver mensagens</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="Model.Pager" />
