@page
@model agot_bg_website.Areas.Admin.Pages.Messages.IndexModel
@{
    ViewData["Title"] = "Admin - Mensagens";
}

<partial name="_AdminNav" />

<h1 class="text-2xl font-bold mb-4">Mensagens</h1>

<form method="get" class="mb-4 flex flex-wrap gap-2 items-center">
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <select name="RoomId" class="select" onchange="this.form.submit()">
        <option value="">-- Escolha uma sala --</option>
        @foreach (var room in Model.RecentRooms)
        {
            <option value="@room.Id" selected="@(room.Id == Model.RoomId)">@room.Name (@room.CreatedAt.ToLocalTime().ToString("g"))</option>
        }
    </select>
    <input type="text" name="RoomSearch" value="@Model.RoomSearch" class="input" placeholder="Buscar sala" />
    <button type="submit" class="btn btn-outline">Buscar salas</button>
    <input type="text" name="Search" value="@Model.Search" class="input" placeholder="Buscar no texto" />
    <button type="submit" class="btn btn-primary">Ir</button>
</form>

@if (Model.RoomId is null)
{
    <p class="opacity-70">Escolha uma sala acima para ver as mensagens.</p>
}
else if (Model.SelectedRoom is null)
{
    <p class="text-error">Sala não encontrada.</p>
}
else
{
    <h2 class="text-lg font-semibold mb-2">@Model.SelectedRoom.Name</h2>
    <div class="overflow-x-auto">
        <table class="table">
            <thead>
                <tr>
                    <th>Usuário</th>
                    <th>Texto</th>
                    <th>Criada</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var message in Model.Messages)
                {
                    <tr>
                        <td>@if (message.User is not null) { <a class="link" href="/user/@message.UserId" target="_blank" rel="noopener noreferrer">@message.User.DisplayName</a> }</td>
                        <td class="whitespace-pre-wrap break-words max-w-xl">@message.Text</td>
                        <td>@message.CreatedAt.ToLocalTime().ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="Model.Pager" />
}
