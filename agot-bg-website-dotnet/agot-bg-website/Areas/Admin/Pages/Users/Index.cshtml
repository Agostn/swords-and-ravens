@page
@model agot_bg_website.Areas.Admin.Pages.Users.IndexModel
@using Microsoft.AspNetCore.Html
@using agot_bg_website.Infrastructure.Auth
@{
    ViewData["Title"] = "Admin - Usuários";

    // Builds a sortable column header link that preserves the current search/page-size and
    // resets back to page 1 (sorting differently makes the previous page number meaningless).
    IHtmlContent SortHeader(string column, string label)
    {
        var url = Url.Page(
            "./Index",
            new
            {
                Search = Model.Search,
                PageNumber = 1,
                PageSize = Model.PageSize,
                SortBy = column,
                SortDir = Model.NextSortDir(column),
            }
        );
        var indicator = Model.SortIndicator(column);
        var text = string.IsNullOrEmpty(indicator) ? label : $"{label} {indicator}";
        return new HtmlString($"<a class=\"link link-hover text-base-content\" href=\"{url}\">{text}</a>");
    }
}

<partial name="_AdminNav" />

<h1 class="text-2xl font-bold mb-4">Usuários</h1>

<partial name="_StatusMessage" for="StatusMessage" />

<form method="get" class="mb-4 flex gap-2">
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <input type="hidden" name="SortBy" value="@Model.SortBy" />
    <input type="hidden" name="SortDir" value="@Model.SortDir" />
    <input type="text" name="Search" value="@Model.Search" class="input" placeholder="Buscar por nome, e-mail ou id" />
    <button type="submit" class="btn btn-primary">Buscar</button>
</form>

<form method="post" asp-page-handler="RecalculateAllStats" asp-route-Search="@Model.Search" asp-route-PageNumber="@Model.PageNumber" asp-route-SortBy="@Model.SortBy" asp-route-SortDir="@Model.SortDir" class="mb-4" onsubmit="return confirm('Recalcular as estatísticas de todos os usuários? Isso roda em segundo plano e pode demorar se houver muitos usuários.');">
    <button type="submit" class="btn btn-sm" title="Recalcular em segundo plano as estatísticas de vitória de todos">Recalcular estatísticas de todos</button>
</form>

<div class="overflow-x-auto">
    <table class="table">
        <thead>
            <tr>
                <th>@SortHeader("username", "Nome")</th>
                <th>@SortHeader("email", "E-mail")</th>
                <th>Funções</th>
                <th>@SortHeader("created", "Criado")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                var roles = Model.RolesByUserId.GetValueOrDefault(user.Id, []);
                var isBanned = roles.Contains(RoleNames.Banned);
                <tr>
                    <td>
                        @if (user.IsDeleted)
                        {
                            @user.DisplayName
                            <span class="badge badge-neutral">Apagado</span>
                        }
                        else
                        {
                            <a class="link" href="/user/@user.Id" target="_blank" rel="noopener noreferrer">@user.DisplayName</a>
                        }
                    </td>
                    <td>@user.Email @(user.IsDeleted ? "" : user.EmailConfirmed ? "" : "(não confirmado)")</td>
                    <td>@string.Join(", ", roles)</td>
                    <td>@user.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td class="flex gap-2">
                        @if (!user.IsDeleted)
                        {
                            <a class="btn btn-sm" asp-page="./Edit" asp-route-id="@user.Id">Editar funções</a>
                            <form method="post" asp-page-handler="RecalculateStats" asp-route-id="@user.Id" asp-route-Search="@Model.Search" asp-route-PageNumber="@Model.PageNumber" asp-route-SortBy="@Model.SortBy" asp-route-SortDir="@Model.SortDir">
                                <button type="submit" class="btn btn-sm" title="Recalcular agora as estatísticas de vitória deste usuário">Recalcular</button>
                            </form>
                            <form method="post" asp-page-handler="ToggleBan" asp-route-id="@user.Id" asp-route-Search="@Model.Search" asp-route-PageNumber="@Model.PageNumber" asp-route-SortBy="@Model.SortBy" asp-route-SortDir="@Model.SortDir">
                                <button type="submit" class="btn btn-sm @(isBanned ? "btn-success" : "btn-error")">
                                    @(isBanned ? "Desbanir" : "Banir")
                                </button>
                            </form>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id" asp-route-Search="@Model.Search" asp-route-PageNumber="@Model.PageNumber" asp-route-SortBy="@Model.SortBy" asp-route-SortDir="@Model.SortDir" onsubmit="return confirm('Apagar esta conta para sempre? Isso não pode ser desfeito.');">
                                <button type="submit" class="btn btn-sm btn-error">Apagar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="Model.Pager" />
