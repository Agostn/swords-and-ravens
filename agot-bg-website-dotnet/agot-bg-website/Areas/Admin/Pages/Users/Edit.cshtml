@page "{id:guid}"
@model agot_bg_website.Areas.Admin.Pages.Users.EditModel
@{
    ViewData["Title"] = "Admin - Funções do usuário";
}

<h1 class="text-2xl font-bold mb-4">Editar funções — @Model.TargetUser.UserName</h1>

<form method="post">
    <h2 class="text-lg font-semibold mb-2">Funções</h2>
    <div class="flex flex-col gap-2 mb-4">
        @foreach (var role in Model.AllRoles)
        {
            <label class="label cursor-pointer justify-start gap-2">
                <input type="checkbox" name="SelectedRoles" value="@role" class="checkbox"
                       checked="@(Model.SelectedRoles.Contains(role))" />
                <span>@role</span>
            </label>
        }
    </div>

    <h2 class="text-lg font-semibold mb-2">Permissões só deste usuário</h2>
    <p class="text-sm opacity-70 mb-2">
        Valem só para este usuário, além do que as funções acima já dão. Prefira
        <a class="link" asp-area="Admin" asp-page="/Roles/Index">editar as permissões da função</a>
        quando a permissão deve valer para todos com aquela função.
    </p>
    <div class="flex flex-col gap-2 mb-4">
        @foreach (var permission in Model.AllPermissions)
        {
            <label class="label cursor-pointer justify-start gap-2">
                <input type="checkbox" name="SelectedPermissions" value="@permission" class="checkbox"
                       checked="@(Model.SelectedPermissions.Contains(permission))" />
                <span>@permission</span>
            </label>
        }
    </div>

    <button type="submit" class="btn btn-primary">Salvar</button>
    <a class="btn" asp-page="./Index">Cancelar</a>
</form>
