@page
@{
    ViewData["Title"] = "Admin";
}

<div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold">Admin</h1>
    <a class="btn btn-sm" href="/coreadmin" target="_blank" rel="noopener">Core Admin</a>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <a class="card bg-base-200 shadow p-4 hover:bg-base-300" asp-area="Admin" asp-page="/Users/Index">
        <h2 class="text-lg font-semibold">Usuários</h2>
        <p class="opacity-70">Buscar usuários, banir/desbanir, editar funções.</p>
    </a>
    <a class="card bg-base-200 shadow p-4 hover:bg-base-300" asp-area="Admin" asp-page="/Games/Index">
        <h2 class="text-lg font-semibold">Partidas</h2>
        <p class="opacity-70">Buscar partidas, ver/editar o JSON salvo da partida, cancelar uma partida.</p>
    </a>
    <a class="card bg-base-200 shadow p-4 hover:bg-base-300" asp-area="Admin" asp-page="/Rooms/Index">
        <h2 class="text-lg font-semibold">Salas de chat</h2>
        <p class="opacity-70">Ver as salas de chat (geral/problemas/de cada partida).</p>
    </a>
    <a class="card bg-base-200 shadow p-4 hover:bg-base-300" asp-area="Admin" asp-page="/Messages/Index">
        <h2 class="text-lg font-semibold">Mensagens</h2>
        <p class="opacity-70">Ver as mensagens de uma sala.</p>
    </a>
</div>

